#!/bin/sh
set -u

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1
local_scanner=$(git rev-parse --git-path tools/gitleaks/gitleaks.exe) || exit 1
if [ -x "$local_scanner" ]; then
    scanner=$local_scanner
elif command -v gitleaks >/dev/null 2>&1; then
    scanner=gitleaks
else
    echo 'Commit stopped: install Gitleaks before committing.' >&2
    exit 1
fi

git diff --cached --no-ext-diff --name-only >/dev/null || exit 1
scan_output=$("$scanner" git --staged --pre-commit --redact=100 --no-color --no-banner --exit-code=42 . 2>&1)
result=$?
printf '%s\n' "$scan_output" >&2
# Some scanner versions return zero despite a logged Git subprocess error.
case "$scan_output" in
    *' ERR '*|*' FTL '*|ERR\ *|FTL\ *)
        echo 'Commit stopped: Gitleaks reported an internal error.' >&2
        exit 1 ;;
esac
if [ "$result" -eq 0 ]; then
    exit 0
fi
if [ "$result" -ne 42 ]; then
    echo 'Commit stopped: Gitleaks failed. A finding override cannot bypass scanner errors.' >&2
    exit 1
fi

tree=$(git write-tree) || exit 1
case "${KANKA_COMMIT_ALLOW_REASON:-}" in
    *[![:space:]]*) reason_present=1 ;;
    *) reason_present=0 ;;
esac
if [ "${KANKA_COMMIT_ALLOW_TREE:-}" = "$tree" ] && [ "$reason_present" -eq 1 ]; then
    echo 'Gitleaks findings explicitly accepted for this exact staged tree. Scan is NOT clean.' >&2
    # Do not echo the reason: it may contain private information.
    exit 0
fi

echo 'Commit stopped: Gitleaks found possible secrets.' >&2
echo 'Remove the finding, approve a narrow test-value exception, or explicitly authorize this exact staged tree.' >&2
exit 1
